# ──────────────────────────────────────────────
# Frontend Environment Variables
# ──────────────────────────────────────────────

# API base URL used by authApi.js for all backend requests.
#
# DEVELOPMENT (default — no .env file needed):
#   The Vite dev server proxies /api → http://localhost:5000
#   (configured in vite.config.js), so VITE_API_URL is optional.
#   If unset, it defaults to "/api".
#
# PRODUCTION:
#   Set this to the full backend URL, e.g.:
#   VITE_API_URL=https://api.your-domain.com/api
#
# VITE_API_URL=/api
